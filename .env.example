# Copy this to .env and fill in your values
# .env is gitignored — never commit it

# Tailscale reusable auth key (unused by bootstrap — OAuth is embedded)
# Get one at: https://login.tailscale.com/admin/settings/keys
# Settings: Reusable ON, Ephemeral OFF, Tags: tag:adspace-pi
TAILSCALE_AUTH_KEY=tskey-auth-xxx

# Headscale override — when LOGIN_SERVER is set, embed.sh / qemu-run.sh
# write adspace-tailnet.env onto the boot partition and bootstrap joins
# Headscale instead of Tailscale.com. The GitHub image job sources this
# file, so these values are the default for flash images built in CI.
# Leave both empty (or omit) for production Tailscale.com.
HEADSCALE_LOGIN_SERVER=https://node1.adsp.to
HEADSCALE_AUTH_KEY=hskey-auth-Tt0RiGM-6H3q-ZkAAgiWsm-KUFgEjlMXgQbZxoIdZ3lN_qZFIgH_5_yyckby3ZGBt8ifyW0wEYX9O
