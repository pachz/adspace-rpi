# Copy this to .env and fill in your values
# .env is gitignored — never commit it

# Tailscale reusable auth key (unused by bootstrap — OAuth is embedded)
# Get one at: https://login.tailscale.com/admin/settings/keys
# Settings: Reusable ON, Ephemeral OFF, Tags: tag:adspace-pi
TAILSCALE_AUTH_KEY=tskey-auth-xxx

# Headscale override — when LOGIN_SERVER is set, qemu-run.sh injects it
# into the guest and bootstrap joins Headscale instead of Tailscale.com.
# Leave both empty (or omit) for production Tailscale.com.
HEADSCALE_LOGIN_SERVER=https://headscale.example.com
HEADSCALE_AUTH_KEY=hskey-auth-xxx
